#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/_lib.sh"

tmp_root="${TMPDIR:-/tmp}"
if [[ "$tmp_root" != /* ]]; then
  tmp_root="/tmp"
fi
updates_file="$(mktemp "$tmp_root/learn-uk-pre-push.XXXXXX")"
trap 'rm -f "$updates_file"' EXIT
tee "$updates_file" >/dev/null

# Scan the Git-supplied updates with machinery's publication scanner before any
# other check. The scanner reads commit messages, ref names and tag text on the
# outgoing range. A scanner that cannot start refuses the push.
if [[ $# -ne 0 ]]; then
  scanner="$worktree_root/lu_machinery/opsec/git_push.py"
  if [[ ! -r "$scanner" ]]; then
    echo "OPSEC: push scanner unavailable; push refused." >&2
    exit 1
  fi
  run_project_python "$hook_dir/pre_push_gate.py" --push-messages "$@" <"$updates_file"
fi
check_owned_paths push <"$updates_file"
run_project_python "$hook_dir/check-pytest-stamp.py" "$@" <"$updates_file"
# Git always supplies the remote name and URL. Only the driver's direct,
# argument-free validation call separates these checks from network transport.
if [[ $# -ne 0 ]]; then
  require_git_lfs
  git lfs pre-push "$@" <"$updates_file"
fi
