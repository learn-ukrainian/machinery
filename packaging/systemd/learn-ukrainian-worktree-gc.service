[Unit]
Description=Learn Ukrainian Git worktree garbage collection
After=network.target

[Service]
Type=oneshot
WorkingDirectory=@REPO_ROOT@
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ -c 'import os,sys; from importlib.resources import files; os.execvp("bash", ["bash", str(files("lu_machinery.orchestration").joinpath("run_scheduled_worktree_cleanup.sh")), *sys.argv[1:]])' --repo-root @REPO_ROOT@ --repo-root @PRIVATE_ROOT@ --apply

[Install]
WantedBy=default.target
