#!/usr/bin/env bash
# Git runs this hook for every push the agent git shim makes, which pins
# core.hooksPath here (#9339): the scanner reads the ref updates Git is about to
# send, then runs the caller's own pre-push hook. The interpreter is the one
# project rule, resolved from this hook's own checkout. That lookup does not
# ask git, so a push-time GIT_DIR cannot redirect it. Without that interpreter
# the push is refused.
set -u
hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$hook_dir/../../.." && pwd)"
# shellcheck disable=SC1091
source "$repo_root/lu_machinery/lib/project_interpreter.sh"
scanner="$(dirname "${BASH_SOURCE[0]}")/../git_push.py"
if ! python="$(project_interpreter_resolve "$repo_root")" || [[ ! -r "$scanner" ]]; then
  echo "OPSEC: push scanner unavailable; push refused." >&2
  exit 1
fi
project_python_command "$python"
exec "${PROJECT_PYTHON_COMMAND[@]}" -m "${PROJECT_PACKAGE}.opsec.git_push" "$@"
