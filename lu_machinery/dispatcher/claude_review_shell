#!/usr/bin/env bash
# CLAUDE_CODE_SHELL_PREFIX of read-only native Claude dispatches (#12378, decision REVIEW-BOUNDARY-1101).
# Claude Code runs "<this file> '<command script>'" for every Bash call; shell_main in
# <package>/dispatcher/agy_sandbox.py runs the script inside the read-only boundary. The code comes
# from the checkout or the installed distribution this file really lives in, never from the reviewed worktree.
refuse() { echo "claude read-only boundary refused: $1" >&2; exit 125; }
self=$(readlink -f -- "$0") || refuse claude_review_shell_unresolved
# This file is <root>/<package>/dispatcher/claude_review_shell, found by directory depth. The package is
# named by the directory the file really lives in, because that is the directory imported from <root>.
dispatcher=${self%/*}
package_dir=${dispatcher%/*}
package=${package_dir##*/}
root=${package_dir%/*}
{ [ "${self##*/}" = claude_review_shell ] && [ "${dispatcher##*/}" = dispatcher ] && [ -n "$root" ]; } ||
  refuse claude_review_shell_root_not_checkout
case $package in '' | [0-9]* | *[!A-Za-z0-9_]*) refuse claude_review_shell_root_not_checkout ;; esac
# <root> is a checkout, or the install directory whose <package>-<version>.dist-info RECORD lists this file (#98).
installed() {
  for record in "$root/$package"-*.dist-info/RECORD; do
    grep -qs "^$package/dispatcher/claude_review_shell," "$record" && return 0
  done
  return 1
}
[ -e "$root/.git" ] || installed || refuse claude_review_shell_root_not_checkout
worktree=$(readlink -f -- "${LU_REVIEW_SHELL_WORKTREE:-/}") || refuse claude_review_shell_worktree_unresolved
case "$root/" in "$worktree"/*) refuse claude_review_shell_root_is_reviewed_worktree ;; esac
# shellcheck disable=SC1091
source "$package_dir/lib/project_interpreter.sh" || refuse claude_review_shell_interpreter_missing
python="$(project_interpreter_resolve "$root")" || refuse claude_review_shell_interpreter_missing
project_python_command "$python" || refuse claude_review_shell_interpreter_missing
exec "${PROJECT_PYTHON_COMMAND[@]}" -c "import sys; from ${package}.dispatcher.agy_sandbox import shell_main; raise SystemExit(shell_main(sys.argv[1:]))" "$@"
